        <mxCell id="okvsHWxxvZg7bijIeuXV-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=5;spacingTop=0;arcSize=0;" value="&lt;b&gt;&lt;u&gt;History:&lt;/u&gt;&lt;/b&gt;&amp;nbsp;&lt;div&gt;Aikido was founded by Morihei Ueshiba (O Sensei, The Shoman) through his knowledge of other martial arts with the goal of allowing the peasants to defend themselves from armed attackers.&amp;nbsp;&lt;/div&gt;&lt;div&gt;The name &quot;Aikido&quot; translates to &quot;The way/path of unifying/harmony with the spirit/life energy.&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="370" x="20" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="okvsHWxxvZg7bijIeuXV-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=5;arcSize=0;" value="&lt;b&gt;&lt;u&gt;Translations:&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;div style=&quot;&quot;&gt;An open-handed strike often has the suffix &quot;uchi&quot; with a grab having the suffix &quot;dori.&quot;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;A technique with the suffix &quot;kyo&quot; is a pin and &quot;nagi&quot; is a throw.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="370" x="20" y="1610" as="geometry" />
        </mxCell>
        <mxCell id="okvsHWxxvZg7bijIeuXV-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;arcSize=0;" value="&lt;b&gt;&lt;u&gt;Etiquette&lt;/u&gt;&lt;/b&gt;&lt;div&gt;In Aikido, there are a lot of rules, with some dojos not being as strict and others being very focused on etiquette. We begin and end with&amp;nbsp;&lt;u&gt;bowing&lt;/u&gt;, when seated sit on your knees in &lt;u&gt;seiza&lt;/u&gt;, during techniques avoid showing your back to the Shoman and always respect your teacher, the mats and your partner.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="370" x="20" y="1680" as="geometry" />
        </mxCell>
        <mxCell id="okvsHWxxvZg7bijIeuXV-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;Close hints&lt;/b&gt;" vertex="1">
